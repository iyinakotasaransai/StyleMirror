# ==============================================================
# StyleMirror Environment Variables Configuration Template
# Copy this file to .env or set environment variables in your system
# ==============================================================

# Database Configuration (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stylemirror
DB_USERNAME=root
DB_PASSWORD=MyNewPass123!

# JWT Secret Key (HMAC-SHA256, at least 256 bits / 32 characters)
JWT_SECRET=StyleMirrorSuperSecureSecretKeyForBTechFinalYearProject2026StyleMirrorSecureToken
JWT_EXPIRATION_MS=86400000

# Google Gemini API Key (Backend-only, never exposed to client)
# Leave as fallback or replace with your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# File Upload Directory (Absolute or relative to project root)
UPLOAD_DIRECTORY=uploads

# Server Port
SERVER_PORT=8080
